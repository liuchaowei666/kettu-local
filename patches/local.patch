+
+/* The DeepSeek balance beside the context meter: a quiet pill that lifts on hover. */
+.kettu-tray-balance {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 1px 8px 1px 7px;
+  border-radius: 999px;
+  background: var(--chip);
+  color: var(--strong);
+  font-size: 11.5px;
+  line-height: 1.7;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  transition: background 140ms ease, transform 140ms ease;
+}
+.kettu-tray-balance::before {
+  content: '';
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: var(--composer-meter-ok, var(--accent));
+  animation: kettu-tray-balance-pulse 2600ms ease-out infinite;
+}
+.kettu-tray-balance:hover {
+  background: var(--chip-hover);
+  transform: translateY(-0.5px);
+}
+.kettu-tray-balance__amount {
+  font-weight: 500;
+  letter-spacing: 0.005em;
+}
+@keyframes kettu-tray-balance-pulse {
+  0% {
+    box-shadow: 0 0 0 0 color-mix(in srgb, var(--composer-meter-ok, var(--accent)) 45%, transparent);
+  }
+  70% {
+    box-shadow: 0 0 0 4px transparent;
+  }
+  100% {
+    box-shadow: 0 0 0 0 transparent;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .kettu-tray-balance,
+  .kettu-tray-balance::before {
+    animation: none;
+    transition: none;
+  }
+}
