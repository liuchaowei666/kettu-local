diff --git a/src/renderer/src/features/usage/usage.css b/src/renderer/src/features/usage/usage.css
index f1294d52..8d11f992 100644
--- a/src/renderer/src/features/usage/usage.css
+++ b/src/renderer/src/features/usage/usage.css
@@ -852,3 +852,102 @@
   outline: 2px solid var(--accent);
   outline-offset: 1px;
 }
+
+/* A balance is money, not a quota window: it gets the card's face to itself, at a size
+   the figure deserves, and it eases in when the card first shows the reading. */
+.k-u-plan__body--balance {
+  align-items: stretch;
+  gap: 10px;
+  margin-top: 2px;
+}
+.k-u-balance {
+  position: relative;
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 3px;
+  min-width: 0;
+  padding: 10px 12px 11px;
+  overflow: hidden;
+  border-radius: 12px;
+  background: var(--chip);
+  animation: k-u-balance-in 460ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
+}
+/* A slow sheen travels across once the figure has landed, then stays out of the way. */
+.k-u-balance::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(105deg, transparent 35%, color-mix(in srgb, var(--strong) 7%, transparent) 50%, transparent 65%);
+  transform: translateX(-120%);
+  animation: k-u-balance-sheen 1400ms 220ms cubic-bezier(0.4, 0, 0.2, 1) 1;
+  pointer-events: none;
+}
+.k-u-balance__label {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+  font-size: 11.5px;
+  line-height: 1.4;
+  color: var(--faint);
+  text-transform: none;
+  letter-spacing: 0.01em;
+}
+.k-u-balance__label::before {
+  content: '';
+  flex: none;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--plan-ok-chip-text, var(--accent));
+  box-shadow: 0 0 0 0 color-mix(in srgb, var(--plan-ok-chip-text, var(--accent)) 45%, transparent);
+  animation: k-u-balance-pulse 2600ms ease-out infinite;
+}
+.k-u-balance__amount {
+  font-size: 21px;
+  line-height: 1.15;
+  font-weight: 600;
+  letter-spacing: -0.012em;
+  color: var(--strong);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+@keyframes k-u-balance-in {
+  from {
+    opacity: 0;
+    transform: translateY(6px) scale(0.985);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+@keyframes k-u-balance-sheen {
+  from {
+    transform: translateX(-120%);
+  }
+  to {
+    transform: translateX(120%);
+  }
+}
+@keyframes k-u-balance-pulse {
+  0% {
+    box-shadow: 0 0 0 0 color-mix(in srgb, var(--plan-ok-chip-text, var(--accent)) 45%, transparent);
+  }
+  70% {
+    box-shadow: 0 0 0 5px transparent;
+  }
+  100% {
+    box-shadow: 0 0 0 0 transparent;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .k-u-balance,
+  .k-u-balance::after,
+  .k-u-balance__label::before {
+    animation: none;
+  }
+}
